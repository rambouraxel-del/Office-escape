{
  "name": "office-escape",
  "version": "0.10.3",
  "private": true,
  "type": "module",
  "description": "Jeu web 2D d'infiltration mobile-first : quitter le bureau avant les heures sup.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "lint": "oxlint src tools tests",
    "lint:fix": "oxlint --fix src tools tests",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tools/**/*.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node tools/make-icons.mjs",
    "budget": "node tools/check-bundle.mjs",
    "build": "tsc --noEmit && vite build",
    "verify": "npm run lint && npm run check && npm run test && npm run build && npm run budget",
    "preview": "vite preview",
    "smoke": "node tools/smoke.mjs",
    "art": "node tools/art/build-art.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.0.0",
    "playwright": "^1.50.0",
    "prettier": "^3.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
